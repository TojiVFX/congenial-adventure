# Telegram Bot Token from @BotFather (e.g. 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz)
BOT_TOKEN=your_bot_token_here

# MongoDB Atlas Connection URI (Free M0 Cluster)
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/auto_approve_bot?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# Admin Telegram User IDs (comma-separated, e.g. 123456789,987654321)
ADMIN_IDS=your_telegram_user_id

# Optional: Default Log Channel ID (e.g. -1001234567890). Can also be configured inside the bot admin panel.
LOG_CHANNEL_ID=

# Deployment URL on Vercel (e.g. https://your-project.vercel.app)
APP_URL=https://your-project.vercel.app

# Optional: Secret token for verifying webhook requests from Telegram
WEBHOOK_SECRET=my_telegram_webhook_secret_123
